*.metrics
*.prof

# Security
*.key
*.pem
*.crt
*.p12
*.jks
secrets/
credentials/

# Temporary and backup files
*.bak
*.backup
*.tmp
*.temp

# System files
Desktop.ini
$RECYCLE.BIN/


