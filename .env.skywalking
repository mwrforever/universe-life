# SkyWalking 分布式追踪系统环境变量配置
# 版本: 10.2.0-java17
# 适用于微服务架构的分布式链路追踪

# =============================================================================
# 基础配置
# =============================================================================
COMPOSE_PROJECT_NAME=skywalking
COMPOSE_FILE=docker-compose-skywalking.yml
TZ=Asia/Shanghai

# =============================================================================
# Elasticsearch 配置
# =============================================================================
ELASTICSEARCH_VERSION=8.11.3
ELASTICSEARCH_HEAP_SIZE=2g
ELASTICSEARCH_CLUSTER_NAME=skywalking-cluster
ELASTICSEARCH_NODE_NAME=es-node-1
ELASTICSEARCH_DISCOVERY_TYPE=single-node
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ELASTICSEARCH_SECURITY_ENABLED=false
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_DATA_DIR=./data/elasticsearch/data
ELASTICSEARCH_LOGS_DIR=./data/elasticsearch/logs

# =============================================================================
# SkyWalking OAP 配置
# =============================================================================
SKYWALKING_VERSION=10.2.0
SKYWALKING_JAVA_IMAGE=java17
SKYWALKING_OAP_HEAP_SIZE=4g
SKYWALKING_OAP_GC=G1GC
SKYWALKING_OAP_GRPC_PORT=11800
SKYWALKING_OAP_REST_PORT=12800
SKYWALKING_OAP_PROMETHEUS_PORT=1234
SKYWALKING_OAP_ZIPKIN_PORT=9411
SKYWALKING_OAP_JAEGER_PORT=14250

# SkyWalking 存储配置
SKYWALKING_STORAGE=elasticsearch
SKYWALKING_STORAGE_ES_CLUSTER_NODES=elasticsearch:9200
SKYWALKING_STORAGE_ES_PROTOCOL=http
SKYWALKING_STORAGE_ES_USER=
SKYWALKING_STORAGE_ES_PASSWORD=
SKYWALKING_STORAGE_ES_INDEX_SHARDS_NUMBER=2
SKYWALKING_STORAGE_ES_INDEX_REPLICAS_NUMBER=0
SKYWALKING_STORAGE_ES_BULK_ACTIONS=2000
SKYWALKING_STORAGE_ES_BULK_SIZE=20
SKYWALKING_STORAGE_ES_FLUSH_INTERVAL=10
SKYWALKING_STORAGE_ES_CONCURRENT_REQUESTS=2

# SkyWalking 接收器配置
SKYWALKING_RECEIVER_ZIPKIN_ENABLED=true
SKYWALKING_RECEIVER_JAEGER_ENABLED=true
SKYWALKING_RECEIVER_OTLP_ENABLED=true
SKYWALKING_RECEIVER_PROMETHEUS_ENABLED=true
SKYWALKING_RECEIVER_BROWSER_ENABLED=true

# SkyWalking 分析配置
SKYWALKING_ANALYSIS_PROFILE_DEFAULT_DURATION=3m
SKYWALKING_ANALYSIS_SLOW_DB_ACCESS_THRESHOLD=default:100,mongodb:100
SKYWALKING_ANALYSIS_SAMPLER_RATE_BASE=1000

# SkyWalking 集群配置
SKYWALKING_CLUSTER=zookeeper
SKYWALKING_CLUSTER_ZOOKEEPER_HOST_PORT=zookeeper:2181
SKYWALKING_CLUSTER_ZOOKEEPER_SESSION_TIMEOUT=30000

# SkyWalking 安全配置
SKYWALKING_AUTHENTICATION_ENABLED=false
SKYWALKING_AUTHENTICATION_ADMIN_PASSWORD=admin123
SKYWALKING_AUTHENTICATION_DEFAULT_USER_PASSWORD=user123

# SkyWalking 数据目录
SKYWALKING_OAP_DATA_DIR=./data/oap/data
SKYWALKING_OAP_LOGS_DIR=./data/oap/logs

# =============================================================================
# SkyWalking UI 配置
# =============================================================================
SKYWALKING_UI_PORT=8080
SKYWALKING_UI_HOST=0.0.0.0
SKYWALKING_UI_OAP_ADDRESS=http://oap:12800
SKYWALKING_UI_TIMEOUT=5000
SKYWALKING_UI_LOGIN_ENABLED=false
SKYWALKING_UI_LOGIN_EXPIRED_DAYS=7
SKYWALKING_UI_TITLE=SkyWalking
SKYWALKING_UI_THEME=light
SKYWALKING_UI_LANGUAGE=cn
SKYWALKING_UI_TIMEZONE=Asia/Shanghai

# SkyWalking UI 数据目录
SKYWALKING_UI_LOGS_DIR=./data/ui/logs

# =============================================================================
# Zookeeper 配置
# =============================================================================
ZOOKEEPER_VERSION=7.5.0
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
ZOOKEEPER_SYNC_LIMIT=2
ZOOKEEPER_MAX_CLIENT_CNXNS=0
ZOOKEEPER_AUTOPURGE_PURGE_INTERVAL=1
ZOOKEEPER_AUTOPURGE_SNAP_RETAIN_COUNT=3

# Zookeeper 数据目录
ZOOKEEPER_DATA_DIR=./data/zookeeper/data
ZOOKEEPER_LOGS_DIR=./data/zookeeper/logs

# =============================================================================
# Nginx 配置
# =============================================================================
NGINX_VERSION=1.25.3-alpine
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_HOST=0.0.0.0

# Nginx 数据目录
NGINX_LOGS_DIR=./data/nginx/logs

# =============================================================================
# Prometheus 配置
# =============================================================================
PROMETHEUS_VERSION=2.45.2
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_WEB_CONSOLE_LIBRARIES=/etc/prometheus/console_libraries
PROMETHEUS_WEB_CONSOLE_TEMPLATES=/etc/prometheus/consoles
PROMETHEUS_STORAGE_WAL_COMPRESSION=true
PROMETHEUS_STORAGE_MIN_BLOCK_DURATION=2h
PROMETHEUS_STORAGE_MAX_BLOCK_DURATION=2h

# Prometheus 数据目录
PROMETHEUS_DATA_DIR=./data/prometheus/data
PROMETHEUS_LOGS_DIR=./data/prometheus/logs

# =============================================================================
# Grafana 配置
# =============================================================================
GRAFANA_VERSION=10.1.5
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_USERS_ALLOW_SIGN_UP=false
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_SERVER_SERVE_FROM_SUB_PATH=true
GRAFANA_SERVER_ENABLE_GZIP=true

# Grafana 插件配置
GRAFANA_INSTALL_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource,grafana-piechart-panel,grafana-worldmap-panel

# Grafana 数据目录
GRAFANA_DATA_DIR=./data/grafana/data
GRAFANA_LOGS_DIR=./data/grafana/logs

# =============================================================================
# 网络配置
# =============================================================================
SKYWALKING_NETWORK_NAME=skywalking-network
SKYWALKING_NETWORK_SUBNET=172.20.0.0/16
SKYWALKING_NETWORK_GATEWAY=172.20.0.1

# =============================================================================
# 安全配置
# =============================================================================
# 跨域配置
SKYWALKING_SECURITY_ALLOWED_ORIGINS=*
SKYWALKING_SECURITY_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
SKYWALKING_SECURITY_ALLOWED_HEADERS=Content-Type,Authorization,x-requested-with

# SSL/TLS 配置 (生产环境建议启用)
SSL_ENABLED=false
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# =============================================================================
# 性能调优配置
# =============================================================================
# JVM 性能参数
JAVA_GC_LOG_ENABLED=true
JAVA_METRICS_ENABLED=true
JAVA_HEAP_DUMP_ON_OOM=true

# 连接池配置
SKYWALKING_CONNECTION_POOL_SIZE=20
SKYWALKING_CONNECTION_TIMEOUT=5000
SKYWALKING_CONNECTION_IDLE_TIMEOUT=60000

# 队列配置
SKYWALKING_QUEUE_MAX_SIZE=10000
SKYWALKING_QUEUE_BATCH_SIZE=100
SKYWALKING_QUEUE_FLUSH_INTERVAL=10

# =============================================================================
# 日志配置
# =============================================================================
# 日志级别配置
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_APACHE_SKYWALKING=INFO
LOGGING_LEVEL_ORG_APACHE_ZOOKEEPER=WARN
LOGGING_LEVEL_ORG_ELASTICSEARCH=WARN

# 日志文件配置
LOGGING_FILE_MAX_SIZE=10MB
LOGGING_FILE_MAX_HISTORY=30
LOGGING_FILE_TOTAL_SIZE_CAP=1GB

# =============================================================================
# 监控配置
# =============================================================================
# 健康检查配置
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD_ELASTICSEARCH=60s
HEALTH_CHECK_START_PERIOD_OAP=120s
HEALTH_CHECK_START_PERIOD_UI=30s
HEALTH_CHECK_START_PERIOD_ZOOKEEPER=30s
HEALTH_CHECK_START_PERIOD_PROMETHEUS=30s
HEALTH_CHECK_START_PERIOD_GRAFANA=60s

# 告警配置
ALARM_ENABLED=true
ALARM_WEBHOOK_URL=http://localhost:8080/alarm
ALARM_MOST_N_TIME=50
ALARM_MOST_N_DURATION=120

# =============================================================================
# 开发环境配置
# =============================================================================
# 调试配置
DEBUG_ENABLED=false
DEBUG_PORT=5005
DEBUG_SUSPEND=n

# 热重载配置
HOT_RELOAD_ENABLED=false
WATCH_FILES_ENABLED=false

# =============================================================================
# 生产环境配置
# =============================================================================
# 资源限制配置 (生产环境)
PRODUCTION_MEMORY_LIMIT=8g
PRODUCTION_CPU_LIMIT=4
PRODUCTION_DISK_LIMIT=100g

# 备份配置
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# =============================================================================
# 第三方集成配置
# =============================================================================
# Kafka 配置 (可选)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_SKYWALKING=skywalking-traces

# Redis 配置 (可选)
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MySQL 配置 (可选)
MYSQL_ENABLED=false
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=skywalking
MYSQL_USERNAME=skywalking
MYSQL_PASSWORD=skywalking

# =============================================================================
# Docker 环境配置
# =============================================================================
DOCKER_REGISTRY=
DOCKER_TAG_PREFIX=
DOCKER_PULL_POLICY=if-not-present
DOCKER_RESTART_POLICY=unless-stopped

# =============================================================================
# 自定义配置
# =============================================================================
# 自定义标签
CUSTOM_LABEL_ENVIRONMENT=development
CUSTOM_LABEL_VERSION=10.2.0
CUSTOM_LABEL_MAINTAINER=devops-team

# 自定义注解
CUSTOM_ANNOTATION_DESCRIPTION=SkyWalking Distributed Tracing System
CUSTOM_ANNOTATION_CREATED_BY=docker-compose

# =============================================================================
# 运维脚本配置
# =============================================================================
# 启动脚本
STARTUP_SCRIPT=./scripts/startup.sh
SHUTDOWN_SCRIPT=./scripts/shutdown.sh
HEALTH_CHECK_SCRIPT=./scripts/health-check.sh
BACKUP_SCRIPT=./scripts/backup.sh
RESTORE_SCRIPT=./scripts/restore.sh

# 日志清理脚本
LOG_CLEANUP_SCRIPT=./scripts/log-cleanup.sh
LOG_CLEANUP_SCHEDULE=0 3 * * *

# 监控脚本
MONITORING_SCRIPT=./scripts/monitoring.sh
MONITORING_INTERVAL=60