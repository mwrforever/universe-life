<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    交易申诉PO Mapper XML映射文件
    
    提供交易申诉的复杂SQL查询实现，包括：
    - 根据订单ID查询申诉列表
    - 分页查询申诉列表
    - 统计查询
    
    @author universe-life
    @since 1.0.0
-->
<mapper namespace="com.universe.life.trade.privacy.infrastructure.persistence.mapper.TradeAppealPOMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.universe.life.trade.privacy.infrastructure.persistence.po.TradeAppealPO">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="appellant_id" property="appellantId"/>
        <result column="appeal_type" property="appealType"/>
        <result column="reason" property="reason"/>
        <result column="evidence_images" property="evidenceImages"/>
        <result column="status" property="status"/>
        <result column="result" property="result"/>
        <result column="handler_id" property="handlerId"/>
        <result column="handle_remark" property="handleRemark"/>
        <result column="handled_at" property="handledAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 通用查询字段 -->
    <sql id="Base_Column_List">
        id, order_id, appellant_id, appeal_type, reason, evidence_images,
        status, result, handler_id, handle_remark, handled_at,
        created_at, updated_at, deleted
    </sql>

    <!-- 根据订单ID查询申诉列表 -->
    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM trade_appeal
        WHERE order_id = #{orderId}
          AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- 分页查询申诉列表 -->
    <select id="selectAppealPage" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM trade_appeal
        WHERE deleted = 0
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{size}
    </select>

    <!-- 统计申诉数量 -->
    <select id="countAppeal" resultType="long">
        SELECT COUNT(1)
        FROM trade_appeal
        WHERE deleted = 0
        <if test="status != null">
            AND status = #{status}
        </if>
    </select>

</mapper>
