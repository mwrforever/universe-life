<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.universe.life.trade.privacy.mapper.TradeAppealMapper">

    <!-- 检查订单是否存在待处理的申诉 -->
    <select id="checkPendingAppeal" resultType="int">
        SELECT COUNT(1)
        FROM trade_appeal
        WHERE order_id = #{orderId}
          AND status = 0  <!-- 待处理 -->
          AND deleted = 0
    </select>

</mapper>
