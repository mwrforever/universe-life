<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.universe.life.task.privacy.mapper.TaskReviewMapper">

    <resultMap id="TaskReviewVOResultMap" type="com.universe.life.task.privacy.domain.vo.TaskReviewVO">
        <id column="id" property="id"/>
        <result column="task_id" property="taskId"/>
        <result column="reviewer_id" property="reviewerId"/>
        <result column="reviewer_name" property="reviewerName"/>
        <result column="status" property="status" typeHandler="org.apache.ibatis.type.EnumOrdinalTypeHandler"/>
        <result column="reject_reason" property="rejectReason"/>
        <result column="reviewed_at" property="reviewedAt"/>
    </resultMap>

    <!-- 查询任务的审核记录列表 -->
    <select id="selectTaskReviews" resultMap="TaskReviewVOResultMap">
        SELECT 
            id, task_id, reviewer_id, status, reject_reason, reviewed_at
        FROM task_review
        WHERE task_id = #{taskId}
        ORDER BY created_at DESC
    </select>

</mapper>
